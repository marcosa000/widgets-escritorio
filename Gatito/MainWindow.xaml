<Window x:Class="Gatito.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simón"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="90" Height="110"
        MouseLeftButtonDown="Presionar" MouseMove="Mover" MouseLeftButtonUp="Soltar">
    <!-- Ventana transparente: los clics sobre lo transparente pasan a lo que hay debajo; solo Simón los recibe. -->
    <Grid>
        <!-- Globito al tocarlo -->
        <Border x:Name="Globo" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
                Background="#F2FFFFFF" CornerRadius="10" Padding="8,3" Visibility="Collapsed">
            <TextBlock Text="¡miau!" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#3A3A3A" />
        </Border>
        <!-- zzz al dormir -->
        <TextBlock x:Name="Zzz" Text="z" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,50,6,0"
                   FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#E6E1E9" Visibility="Collapsed" />

        <Image x:Name="Sprite" VerticalAlignment="Bottom" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,1">
            <Image.RenderTransform>
                <!-- Las poses miran a la derecha; -1 lo da vuelta para caminar a la izquierda -->
                <ScaleTransform x:Name="Volteo" ScaleX="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
