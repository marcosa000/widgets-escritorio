<UserControl
    x:Class="Widgets.Vistas.RelojView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource TarjetaWidget}">
        <StackPanel Spacing="4">
            <!-- El reloj y el panel para escribir una nota o tarea ocupan la misma celda: el panel se muestra
                 en lugar del reloj, así el widget no cambia de alto ni se reacomoda el bloque. -->
            <Grid>
                <StackPanel x:Name="VistaReloj" Spacing="4">
                    <TextBlock x:Name="Hora" FontSize="64" FontWeight="Light" Foreground="{StaticResource TextoPrimario}" />
                    <TextBlock x:Name="Fecha" FontSize="16" Foreground="{StaticResource TextoSecundario}" />
                    <HyperlinkButton Click="AbrirAlarmas" Padding="0" Margin="0,4,0,0" ToolTipService.ToolTip="Abrir Alarmas y reloj" AutomationProperties.Name="Abrir Alarmas y reloj">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{StaticResource Acento}" />
                            <TextBlock x:Name="Proximo" Style="{StaticResource Meta}" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <!-- Oculto con Opacity (y no Visibility) para que la celda mida siempre lo mismo -->
                <Grid x:Name="Captura" RowSpacing="8" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="Entrada" MaxHeight="90" CornerRadius="12" TextWrapping="Wrap" KeyDown="TeclaEntrada" IsTabStop="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EstadoCaptura" Style="{StaticResource Meta}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="Cancelar" Click="CerrarCaptura" Height="32" CornerRadius="16" Padding="12,0"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextoSecundario}" />
                        <Button x:Name="BotonGuardar" Grid.Column="2" Content="Guardar" Click="Guardar" Style="{StaticResource BotonPildora}"
                                Padding="14,0" FontWeight="SemiBold" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Barra de accesos rápidos -->
            <Border Background="{StaticResource SuperficieFila}" CornerRadius="16" Padding="6"
                    HorizontalAlignment="Left" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Style="{StaticResource BotonIcono}" Width="40" Height="40" CornerRadius="12" Tag="nota"
                            Click="Capturar" ToolTipService.ToolTip="Nueva nota en Keep" AutomationProperties.Name="Nueva nota en Keep">
                        <FontIcon Glyph="&#xE70B;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource BotonIcono}" Width="40" Height="40" CornerRadius="12" Tag="tarea"
                            Click="Capturar" ToolTipService.ToolTip="Nueva tarea en Google Tasks" AutomationProperties.Name="Nueva tarea en Google Tasks">
                        <FontIcon Glyph="&#xE73A;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource BotonIcono}" Width="40" Height="40" CornerRadius="12" Tag="ms-paint:"
                            Click="Acceso" ToolTipService.ToolTip="Dibujo (Paint)" AutomationProperties.Name="Dibujo (Paint)">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource BotonIcono}" Width="40" Height="40" CornerRadius="12" Tag="microsoft.windows.camera:"
                            Click="Acceso" ToolTipService.ToolTip="Foto (Cámara)" AutomationProperties.Name="Foto (Cámara)">
                        <FontIcon Glyph="&#xE722;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
