<UserControl
    x:Class="Widgets.Vistas.TareasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource TarjetaWidget}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tareas" Style="{StaticResource TituloWidget}" />
                <Border x:Name="EtiquetaContador" Grid.Column="1" HorizontalAlignment="Left" Margin="4,0,0,0" Style="{StaticResource Etiqueta}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="Contador" FontSize="11" Foreground="{StaticResource TextoSecundario}" />
                </Border>
                <Button x:Name="BotonCompletadas" Grid.Column="2" Style="{StaticResource BotonIcono}" Click="AlternarCompletadas"
                        ToolTipService.ToolTip="Mostrar completadas" AutomationProperties.Name="Mostrar completadas">
                    <FontIcon x:Name="IconoCompletadas" Glyph="&#xE73E;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource BotonPildora}" Click="NuevaTarea"
                        ToolTipService.ToolTip="Nueva tarea" AutomationProperties.Name="Nueva tarea">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock x:Name="Mensaje" Grid.Row="1" VerticalAlignment="Top" Text="Cargando…" Style="{StaticResource Meta}" TextWrapping="Wrap" />
            <!-- "Flexible": ver AgendaView. Tope de ~5 tareas para el alto mínimo. -->
            <ScrollViewer x:Name="Flexible" Tag="170" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Lista" Spacing="2" />
            </ScrollViewer>

            <!-- Editor (tarea nueva o existente): ocupa el mismo alto que tenía la lista -->
            <Grid x:Name="Editor" Grid.Row="1" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="TituloTarea" CornerRadius="12" PlaceholderText="Tarea" AutomationProperties.Name="Título de la tarea"
                         KeyDown="TeclaEditor" />
                <TextBox x:Name="NotasTarea" Grid.Row="1" MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap" CornerRadius="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="Notas (opcional)"
                         AutomationProperties.Name="Notas de la tarea" KeyDown="TeclaEditor" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker x:Name="FechaTarea" PlaceholderText="Sin fecha" CornerRadius="12" MinWidth="150"
                                        AutomationProperties.Name="Fecha de vencimiento" />
                    <Button x:Name="QuitarFecha" Content="Sin fecha" Click="SinFecha" Height="32" CornerRadius="16" Padding="12,0"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextoSecundario}" />
                </StackPanel>
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EstadoTarea" Style="{StaticResource Meta}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                    <Button Grid.Column="1" Content="Cancelar" Click="Cancelar" Height="32" CornerRadius="16" Padding="12,0"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextoSecundario}" />
                    <Button x:Name="GuardarTarea" Grid.Column="2" Content="Guardar" Click="Guardar" Style="{StaticResource BotonPildora}"
                            Padding="14,0" FontWeight="SemiBold" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
